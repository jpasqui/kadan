  "acceptance_chain": [
    {
      "check": "acceptance_import_map",
      "what": "An original game map is imported into a clean project."
    },
    {
      "check": "acceptance_compare_source",
      "what": "Every imported item is compared with the game's files and equals them."
    },
    {
      "check": "acceptance_edit",
      "what": "The map is edited through ordinary Unreal assets and actors: changes, additions and deletions."
    },
    {
      "check": "acceptance_save_reopen",
      "what": "The project is saved and reopened in a second editor process with nothing lost."
    },
    {
      "check": "acceptance_export",
      "what": "The mod is exported: baked, cooked and packed."
    },
    {
      "check": "acceptance_no_game_assets",
      "what": "The exported mod holds none of the game's own assets."
    },
    {
      "check": "acceptance_play",
      "what": "The exported mod runs in the game and shows the edits."
    }
  ],
  "required_checks": [
    "native_unit",
    "native_sanitizers",
    "native_static_analysis",
    "warning_clean_build",
    "editor_undo_redo",
    "editor_lifetime",
    "threaded_cancellation",
    "parser_corruption",
    "pristine_bundle",
    "ui_performance",
    "acceptance_import_map",
    "acceptance_compare_source",
    "acceptance_edit",
    "acceptance_save_reopen",
    "acceptance_export",
    "acceptance_no_game_assets",
    "acceptance_play"
  ],
  "import_policy": "No silent data loss. Preserve full private source, account for all features and dependencies, independently compare staged readback, and refuse incomplete publication.",
  "release_policy": "A release is decided by the acceptance chain, passed link by link on one original map with the exact distributable, and by the other required checks. The exact distributable must pass. Unmeasured, stale, missing or unsupported evidence and unresolved regressions block release. Passing repeats do not resolve an unexplained failure. Engine/generated/third-party sources are outside the owned source denominator; handwritten kit sources are never silently excluded.",
  "coverage_contracts": {
    "runtime": {
      "target": "aarch64-none-elf",
      "cxx_standard": "C++20",
      "freestanding": true
    }
  }
}
