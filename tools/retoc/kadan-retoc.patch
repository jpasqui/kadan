+// The export bundle of a legacy zen package (UE 4.26/4.27) that holds the given command of the export with the given
+// global import index, or None.
+pub fn legacy_export_bundle_of(header: &FZenPackageHeader, export: FPackageObjectIndex, command: EExportCommandType) -> Option<i32> {
+    let local = header.export_map.iter().position(|entry| entry.legacy_global_import_index() == export)? as u32;
+    for (index, bundle) in header.export_bundle_headers.iter().enumerate() {
+        let first = bundle.first_entry_index as usize;
+        let entries = header.export_bundle_entries.get(first..first + bundle.entry_count as usize)?;
+        if entries.iter().any(|entry| entry.local_export_index == local && entry.command_type == command) {
+            return Some(index as i32);
+        }
+    }
+    None
+}
 pub fn get_cell_export_hash(verse_path: &str) -> u64 {
     cityhasher::hash(verse_path.as_bytes())
 }
